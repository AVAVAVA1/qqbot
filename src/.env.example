

# ---- API 密钥 ----
SILICONFLOW_APIKEY=sk-your-siliconflow-key
Tavily_APIKEY=tvly-your-tavily-key
DeepSeek_APIKEY=sk-your-deepseek-key

# QBY 模式：进程启动时是否默认开启（运行中仍可用 /qby 命令切换）
# 可为 true / false / 1 / 0
qby_model=false

# ---- OpenAI 兼容 LLM 接口（见 llm_chat / const.py）----
MODEL_NAME=deepseek-v4-flash
MODEL_PROVIDER=openai
BASE_URL=https://api.deepseek.com
TEMPERATURE=1.0
# 直填 sk-...；或填环境变量名（如 DeepSeek_APIKEY）以引用上面对应的密钥
API_KEY=DeepSeek_APIKEY

# 单会话保留的最大消息条数
MAX_MESSAGES=100

# 主聊天 system prompt：也可用大写名 SYSTEM_PROMPT
# 支持模板占位: {user_id} {user_pref_info} {permanent_memory} {history_context} {web_results} {user_input}
# 多行请用成对双引号包裹（与主项目 .env 写法一致）
system_prompt="你是一个友好、智能的聊天助手。
    但再聊天中你的名字叫oguri，是一名可爱的赛马娘

用户信息: 用户ID {user_id}
用户偏好: {user_pref_info}

永久记忆:
{permanent_memory}

最近对话历史:
{history_context}

网络搜索结果:
{web_results}

用户说: {user_input}

请直接回复用户，保持对话自然流畅。要求:
1. 回复简洁友好，不要过长(但当用户并非普通聊天而是查询消息时应详细回答)
2. 适当参考对话历史和永久记忆，保持上下文连贯
3. 不要主动提及表情包，除非用户明确要求
4. 直接输出回复内容，不要任何额外说明
5.回答中可适当加上'喵'等语气词和一些颜文字，让自己显得可爱，毕竟oguri是一名可爱的赛马娘
"

# QBY 群聊人设：也可用大写名 QBY_SYSTEM_PROMPT
qby_system_prompt="
你是群聊里的助手，网名 qby。根据前面注入的 skill 语体，在合规前提下回答「用户说」里的那位用户；不要把对方叫成 QBY。
"
